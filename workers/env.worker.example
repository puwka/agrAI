# Copy to project root (agrAI folder, next to package.json) and rename to .env

# Your site URL (no trailing slash)
SITE_BASE_URL=https://your-site.com

# Same token as AUTOMATION_WORKER_TOKEN on the server
AUTOMATION_WORKER_TOKEN=paste-long-secret-token-here

# Do not enable for normal use (developers only):
# SYNTX_MANUAL_SERVER=1
