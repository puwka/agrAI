# ─── Supabase (URL + Keys) ────────────────────────────────────────────────────
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY="<anon-key>"
# Только для серверных задач/cron/admin API. Никогда не отдавать на клиент.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Имя бакета в Supabase Storage для загрузок (создайте в Dashboard → Storage; для превью в браузере включите публичный доступ к объектам).
SUPABASE_STORAGE_BUCKET="agrai-uploads"
# Таймауты HTTP для PostgREST/Storage в lib/db.ts (мс). При медленном Supabase увеличьте write.
# SUPABASE_FETCH_TIMEOUT_MS="60000"
# SUPABASE_FETCH_WRITE_TIMEOUT_MS="120000"
# SUPABASE_FETCH_RETRIES="4"
# Куда сохранять файлы результатов генераций (POST …/internal/syntx/jobs/:id/complete).
# По умолчанию — диск на сервере (.runtime/uploads/generations, в БД local-generation:…), без Supabase Storage.
# Явно включить Storage: GENERATION_RESULTS_STORAGE=supabase
# GENERATION_RESULTS_STORAGE="local"
# Повторы find/update в complete при временных ошибках Supabase (1–8).
# SYNTX_COMPLETE_DB_RETRIES="5"
# ─── NextAuth ────────────────────────────────────────────────────────────────
# Локально
NEXTAUTH_URL="http://localhost:3000"
# Продакшен / preview: https://<проект>.vercel.app или свой домен (без слэша в конце)
# NEXTAUTH_URL="https://your-app.vercel.app"
# Preview/prod fallback: NEXTAUTH_URL подставляется из VERCEL_URL в instrumentation.ts (next-auth v4).

NEXTAUTH_SECRET="replace-with-long-random-string-min-32-chars"

# ─── Automation workers ──────────────────────────────────────────────────────
# Bearer-токен для внешних Python-воркеров (Syntx/Google Flow/SecretVoicer).
# Воркер отправляет Authorization: Bearer <token>.
AUTOMATION_WORKER_TOKEN="replace-with-long-random-worker-token"
# Можно задать отдельный токен только для Syntx; если пусто, используется AUTOMATION_WORKER_TOKEN.
# SYNTX_WORKER_TOKEN="replace-with-syntx-worker-token"
# Ручной Syntx-воркер (Playwright на машине разработчика): админка → POST на URL ниже → воркер → POST …/complete на SITE_BASE_URL.
# В next dev URL триггера по умолчанию http://127.0.0.1:8765/run (если SYNTX_WORKER_TRIGGER_URL не задан).
# SYNTX_WORKER_TRIGGER_URL="http://127.0.0.1:8765/run"
# Токен в заголовке триггера: SYNTX_WORKER_TRIGGER_TOKEN или (если пусто) SYNTX_WORKER_TOKEN / AUTOMATION_WORKER_TOKEN — как у процесса Python.
# Результат complete по умолчанию на диск (.runtime/…, local-generation: в БД), без Supabase Storage — см. GENERATION_RESULTS_STORAGE.
# Запуск воркера (PowerShell): $env:SYNTX_MANUAL_SERVER="1"; $env:SITE_BASE_URL="http://localhost:3000"; … python workers/syntx_worker.py
# Если не задан, для вызова ручного воркера используется SYNTX_WORKER_TOKEN/AUTOMATION_WORKER_TOKEN.
# SYNTX_WORKER_TRIGGER_TOKEN="replace-with-manual-worker-token"
#
# Сайт на VPS, Syntx-воркер на своём ПК (типично):
# — Режим опроса (рекомендуется): на ПК не ставьте SYNTX_MANUAL_SERVER (или "0"), SITE_BASE_URL=https://ваш-домен
#   и тот же AUTOMATION_WORKER_TOKEN (или SYNTX_WORKER_TOKEN), что на VPS. Воркер дергает POST …/api/internal/syntx/jobs.
#   Заявки Veo 3.1 / Sora Image в PENDING/QUEUED подхватятся без кнопки «Воркер».
# — Кнопка «Воркер» шлёт HTTP с VPS на SYNTX_WORKER_TRIGGER_URL. До 127.0.0.1 на вашем ПК VPS не достучится —
#   нужен публичный URL туннеля (ngrok, Cloudflare Tunnel, Tailscale …) на локальный :8765/run, либо не используйте кнопку.
#
# HTTP к SITE_BASE_URL с ПК (опрос заявок): таймауты при медленном VPS/Supabase.
# SYNTX_HTTP_CONNECT_TIMEOUT_SEC="20"
# SYNTX_CLAIM_READ_TIMEOUT_SEC="120"
# За корпоративным прокси попробуйте передать системный прокси в requests: SYNTX_REQUESTS_TRUST_ENV="1"
#
# Основной режим Syntx-воркера: Playwright сам ищет элементы по DOM/текстам/aria.
# Поставьте 0, чтобы временно отключить smart-режим и использовать только selector/coordinate fallback.
# SYNTX_SMART_MODE="1"
# Сколько раз нажимать Generate/Создать в smart/coordinate режиме.
# SYNTX_GENERATE_CLICK_COUNT="10"
# Сколько быстрых кликов подряд за один «раунд» по кнопке отправки (Syntx часто принимает только с N-й попытки).
# SYNTX_GENERATE_BURST_CLICKS="12"
# SYNTX_GENERATE_CLICK_INTERVAL_MS="450"
# Пауза между попытками открыть Element Plus select, пока aria-expanded не станет true.
# SYNTX_UI_CLICK_RETRIES="8"
# SYNTX_UI_CLICK_INTERVAL_MS="250"
# Закрытие боковой панели чатов (session list): число итераций.
# SYNTX_SESSION_DRAWER_CLOSE_ATTEMPTS="12"
# По умолчанию воркер не создаёт новую сессию; только при SYNTX_NEW_SESSION="1".
# SYNTX_NEW_SESSION="0"
# Опционально: разные селекторы Syntx для разных моделей. Это fallback, если smart-режим не справился.
# SYNTX_VEO_3_1_RELAX_PROMPT_SELECTOR="textarea"
# SYNTX_SORA_IMAGE_PROMPT_SELECTOR="textarea"
# Воркер не создает проект. Он открывает Syntx, выбирает модель/aspect, вставляет prompt/ref и генерирует.
# SYNTX_SORA_IMAGE_MODEL_TRIGGER_SELECTOR="..."
# Для Sora Images 0 = семейство модели, 1 = версия внутри Sora ("GPT Image 1"). Не ставить 0.
# SYNTX_SORA_IMAGE_MODEL_TRIGGER_INDEX="1"
# SYNTX_SORA_IMAGE_FIRST_MODEL_SELECTOR=".el-select-dropdown__item:not(.is-disabled)"
# SYNTX_SORA_IMAGE_ASPECT_TRIGGER_SELECTOR="..."
# SYNTX_ASPECT_1_1_SELECTOR="text=1:1"
# SYNTX_ASPECT_3_2_SELECTOR="text=3:2"
# SYNTX_ASPECT_2_3_SELECTOR="text=2:3"
# SYNTX_SORA_IMAGE_REFERENCE_UPLOAD_SELECTOR="input[type='file']"
# Sora Images: отправка — иконка без текста; по умолчанию воркер использует .ml-2.chat-input__button
# SYNTX_SORA_IMAGE_GENERATE_SELECTOR=".chat-input__actions-right button.ml-2.chat-input__button"
# Sora Images: перед скачиванием чат прокручивается вниз (кнопка под картинкой).
# Сначала «прилипание» к низу всех скроллов + End + wheel (отключить: SYNTX_DOWNLOAD_SCROLL_SNAP_FIRST="0").
# SYNTX_DOWNLOAD_SCROLL_SNAP_FIRST="1"
# SYNTX_DOWNLOAD_SCROLL_PX="720"
# SYNTX_DOWNLOAD_SCROLL_STEPS="6"
# Меньше шагов прокрутки, когда картинка результата уже видна.
# SYNTX_DOWNLOAD_SCROLL_STEPS_FAST="2"
# SYNTX_DOWNLOAD_POLL_MS="600"
# Таймаут ожидания одного клика «Скачать» (Playwright expect_download).
# SYNTX_DOWNLOAD_EXPECT_MS="12000"
# Первая попытка скачивания после появления картинки — дольше (меньше ложных ретраев и повторных кликов).
# SYNTX_DOWNLOAD_FIRST_EXPECT_MS="45000"
# После Generate: ждём появления большой картинки в чате (мс таймаут / опрос).
# SYNTX_RESULT_READY_TIMEOUT_MS="300000"
# SYNTX_RESULT_READY_POLL_MS="800"
# SYNTX_POST_GENERATE_SETTLE_MS="2000"
# Список контейнеров для wheel/scroll через запятую (если дефолт не подходит).
# SYNTX_CHAT_SCROLL_SELECTOR=".chat__content .el-scrollbar__wrap,.chat-layout__workspace"
# SYNTX_SORA_IMAGE_DOWNLOAD_SELECTOR="..."
# Аварийный fallback: запись координат через workers/syntx_calibrate.py.
# SYNTX_COORDS_FILE="workers/syntx_coords.json"
# SYNTX_VIEWPORT_WIDTH="1365"
# SYNTX_VIEWPORT_HEIGHT="768"
