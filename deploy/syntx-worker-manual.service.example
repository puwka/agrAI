# Пример systemd для Syntx-воркера в режиме ручного триггера (кнопка в админке).
#
# 1) На сервере: python3 -m venv /var/www/agrai/.venv
#    source .venv/bin/activate && pip install requests playwright && playwright install chromium
#    playwright install-deps chromium   # при необходимости
# 2) Скопируйте deploy/syntx-worker.env.example → /var/www/agrai/.env.syntx и заполните.
# 3) chmod +x /var/www/agrai/workers/run_syntx_worker.sh
# 4) Подставьте User/Group/пути, затем:
#    sudo cp syntx-worker-manual.service.example /etc/systemd/system/syntx-worker.service
#    sudo systemctl daemon-reload
#    sudo systemctl enable --now syntx-worker
#    sudo journalctl -u syntx-worker -f
#
# В .env Next на том же хосте:
#   SYNTX_WORKER_TRIGGER_URL=http://127.0.0.1:8765/run
# Токен триггера (если задан SYNTX_WORKER_TRIGGER_TOKEN) должен совпадать с тем, что ожидает воркер.

[Unit]
Description=Syntx Playwright worker (manual HTTP, admin button)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/agrai

# Секреты и URL — только в .env.syntx на сервере (chmod 600).
EnvironmentFile=/var/www/agrai/.env.syntx

ExecStart=/var/www/agrai/workers/run_syntx_worker.sh

Restart=always
RestartSec=15

# Ограничение перезапусков при битой конфигурации (опционально раскомментируйте).
# StartLimitIntervalSec=300
# StartLimitBurst=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
