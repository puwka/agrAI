# Скопируйте на сервер как /var/www/agrai/.env.syntx (права 600, не в git).
# Подставьте свои значения. Этот файл подхватывает systemd (см. syntx-worker-manual.service.example).

SITE_BASE_URL=https://ai.gptml.ru
AUTOMATION_WORKER_TOKEN=тот_же_что_AUTOMATION_WORKER_TOKEN_в_next

SYNTX_STORAGE_STATE=/var/www/agrai/workers/syntx_storage_state.json
SYNTX_HEADLESS=1

# Режим «по кнопке» в админке: Next бьёт в SYNTX_WORKER_TRIGGER_URL (127.0.0.1:8765/run).
SYNTX_MANUAL_SERVER=1
SYNTX_MANUAL_HOST=127.0.0.1
SYNTX_MANUAL_PORT=8765
